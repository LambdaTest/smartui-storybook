{
  "name": "@lambdatest/smartui-storybook",
  "version": "1.2.0",
  "description": "TestMu AI's command-line interface (CLI) to run SmartUI visual regression tests for your Storybook stories across 3000+ real browsers",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LambdaTest/smartui-storybook.git"
  },
  "homepage": "https://www.testmuai.com/smart-visual-ui-testing/",
  "scripts": {
    "test": "jest --config=./test/jest.config.js"
  },
  "bin": {
    "smartui": "./index.js"
  },
  "keywords": [
    "storybook-addon",
    "test",
    "visual-testing",
    "visual-regression",
    "vrt",
    "screenshot-testing",
    "cross-browser-testing",
    "ui-testing",
    "smartui",
    "lambdatest",
    "testmuai"
  ],
  "storybook": {
    "displayName": "SmartUI",
    "icon": "https://avatars.githubusercontent.com/u/27130435?s=200&v=4",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact"
    ],
    "unsupportedFrameworks": [
      "react-native"
    ]
  },
  "bugs": {
    "url": "https://github.com/LambdaTest/smartui-storybook/issues"
  },
  "author": "TestMu AI <support@testmuai.com>",
  "license": "MIT",
  "dependencies": {
    "@lambdatest/node-tunnel": "^4.0.9",
    "archiver": "^5.3.1",
    "axios": "^1.12.0",
    "chalk": "^5.2.0",
    "cli-table3": "^0.6.3",
    "commander": "^9.5.0",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "jest": "^29.5.0"
  }
}
