    "finalhandler": "^1.2.0",
    "form-data": "^4.0.0",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "jsdom": "^21.1.0",
    "lodash": "^4.17.21",
    "puppeteer": "^19.5.2",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "jest": "^29.5.0"
  }
